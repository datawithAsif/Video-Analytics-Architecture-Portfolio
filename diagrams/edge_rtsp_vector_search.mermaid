flowchart TD
    subgraph Stage1 ["Stage 1: Multi-Camera Ingestion"]
        CAMS["Facility IP Cameras<br>Continuous 25 FPS RTSP Stream"]
        BUFFER["Decoupled Stream Buffer<br>Single-frame queue prevents socket lag"]
        CAMS --> BUFFER
    end

    subgraph Stage2 ["Stage 2: Edge Inference"]
        DETECT["Face Detection Engine<br>Localizes faces in continuous video"]
        EXTRACT["Biometric Embedding Model<br>Generates compact 128-d identity vector"]
        BUFFER --> DETECT --> EXTRACT
    end

    subgraph Stage3 ["Stage 3: Vector Search"]
        SEARCH["PostgreSQL + pgvector<br>Indexed search across 20,000+ staff in < 5ms"]
        MATCHED["Identity Resolved<br>Unique employee code identified"]
        EXTRACT --> SEARCH --> MATCHED
    end

    subgraph Stage4 ["Stage 4: State Deduplication & Logging"]
        COOLDOWN{"Active Check-In<br>Within Last 5 Minutes?"}
        SAVE["Attendance Logged<br>Written to HR database with timestamp"]
        IGNORE["Duplicate Suppressed<br>Prevents multiple logs during single transit"]
        
        MATCHED --> COOLDOWN
        COOLDOWN -->|No: First Detection| SAVE
        COOLDOWN -->|Yes: Recent Detection| IGNORE
    end

    style Stage1 fill:#f8fafc,stroke:#94a3b8,stroke-width:1px
    style Stage2 fill:#f0f9ff,stroke:#0284c7,stroke-width:1px
    style Stage3 fill:#fefce8,stroke:#ca8a04,stroke-width:1px
    style Stage4 fill:#f0fdf4,stroke:#16a34a,stroke-width:1px
